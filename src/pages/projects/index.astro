---
// Projects listing (/projects/) -> Redirección a la ruta de Laboratorios (/laboratorios/).
import siteData from "@config/siteData.json";
import BaseLayout from "@layouts/BaseLayout.astro";

const labsUrl = `${import.meta.env.BASE_URL}laboratorios/`;
---

<BaseLayout
  title={`Laboratorios — ${siteData.name}`}
  description="Redirección a los laboratorios computacionales del curso Sistemas de Información Geográfica."
>
  <head slot="head">
    <meta http-equiv="refresh" content={`0;url=${labsUrl}`} />
  </head>
  <div class="site-container flex flex-col items-center justify-center gap-6 py-20 text-center">
    <h1 class="h2 text-foreground">Redirigiendo a Laboratorios SIG...</h1>
    <p class="text-muted-foreground text-sm">
      Si la página no redirige automáticamente, haz clic abajo:
    </p>
    <a href={labsUrl} class="pixel-btn pixel-btn--blue px-5 py-3 text-xs uppercase sm:text-base">
      Ir a Laboratorios SIG ➔
    </a>
  </div>
</BaseLayout>
