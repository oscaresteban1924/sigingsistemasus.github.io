---
// Home (/). Portada oficial de la plataforma académica SIG - Ingeniería de Sistemas.
import About from "@components/Sections/Home/About.astro";
import Contact from "@components/Sections/Home/Contact.astro";
import FeaturedProjects from "@components/Sections/Home/FeaturedProjects.astro";
import Hero from "@components/Sections/Home/Hero.astro";
import LatestPosts from "@components/Sections/Home/LatestPosts.astro";
import PipelineSection from "@components/Sections/Home/PipelineSection.astro";
import Stats from "@components/Sections/Home/Stats.astro";
import TechStack from "@components/Sections/Home/TechStack.astro";
import siteData from "@config/siteData.json";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title={siteData.title} description={siteData.description}>
  <div class="site-container flex flex-col gap-10 py-8 md:gap-12 md:py-12">
    <Hero />
    <Stats />
    <PipelineSection />
    <About />
    <TechStack />
    <LatestPosts />
    <FeaturedProjects />
    <Contact />
  </div>
</BaseLayout>
