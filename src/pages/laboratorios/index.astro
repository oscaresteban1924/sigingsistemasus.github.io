---
// Laboratorios (/laboratorios/). Ruta principal de laboratorios computacionales SIG.
import LaboratorioCard from "@components/Sections/Laboratorios/LaboratorioCard.astro";
import LaboratoriosHero from "@components/Sections/Laboratorios/LaboratoriosHero.astro";
import siteData from "@config/siteData.json";
import { getSortedLaboratorios } from "@js/laboratoriosData";
import BaseLayout from "@layouts/BaseLayout.astro";

const laboratorios = await getSortedLaboratorios();
---

<BaseLayout
  title={`Laboratorios SIG — ${siteData.name}`}
  description="Laboratorios computacionales de Sistemas de Información Geográfica para Ingeniería de Sistemas. Experimentación con GeoJSON, PostGIS, Spatial SQL, Python y servicios OGC."
>
  <div class="site-container flex flex-col gap-10 py-8 md:gap-12 md:py-12">
    <LaboratoriosHero />

    <div class="flex flex-col gap-6">
      <div class="border-border flex items-center justify-between border-b-4 pb-4">
        <h2 class="h2 text-foreground uppercase">Catálogo de Laboratorios Computacionales</h2>
        <span class="font-display text-info text-xs uppercase">
          {laboratorios.length} Laboratorios Programados
        </span>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {laboratorios.map((lab) => <LaboratorioCard lab={lab} />)}
      </div>
    </div>
  </div>
</BaseLayout>
