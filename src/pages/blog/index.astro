---
// Blog listing (/blog/) -> Redirección / alias a la ruta de Semanas (/semanas/).
import siteData from "@config/siteData.json";
import BaseLayout from "@layouts/BaseLayout.astro";

const semanasUrl = `${import.meta.env.BASE_URL}semanas/`;
---

<BaseLayout
  title={`Semanas — ${siteData.name}`}
  description="Redirección a las semanas académicas del curso de Sistemas de Información Geográfica."
>
  <head slot="head">
    <meta http-equiv="refresh" content={`0;url=${semanasUrl}`} />
  </head>
  <div class="site-container flex flex-col items-center justify-center gap-6 py-20 text-center">
    <h1 class="h2 text-foreground">Redirigiendo a las Semanas del Curso...</h1>
    <p class="text-muted-foreground text-sm">
      Si la página no redirige automáticamente, haz clic abajo:
    </p>
    <a href={semanasUrl} class="pixel-btn pixel-btn--blue px-5 py-3 text-xs uppercase sm:text-base">
      Ir a Semanas del Curso ➔
    </a>
  </div>
</BaseLayout>
