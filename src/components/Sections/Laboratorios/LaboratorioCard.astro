---
// src/components/Sections/Laboratorios/LaboratorioCard.astro — Tarjeta de laboratorio computacional.
import { PixelIcon } from "@components/svg/pixel-icons";
import { Badge } from "@components/ui/badge";
import { PixelPanel } from "@components/ui/pixel-panel";
import { dificultadBadgeMeta, faseBadgeMeta } from "@js/laboratoriosData";
import { laboratorioPath } from "@js/paths";
import { estadoBadgeMeta } from "@js/semanasData";
import type { CollectionEntry } from "astro:content";

interface Props {
  lab: CollectionEntry<"laboratorios">;
}

const { lab } = Astro.props as Props;
const { data } = lab;
const { label: badgeEstado, variant: variantEstado } = estadoBadgeMeta(data.estado);
const { label: badgeDif, variant: variantDif } = dificultadBadgeMeta(data.dificultad);
const isAvailable = data.estado === "Disponible";
const numFormatted = String(data.numero).padStart(2, "0");
---

<PixelPanel elevated={isAvailable} class="flex flex-col justify-between gap-4 p-6">
  <div class="flex flex-col gap-3">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="font-display text-info text-xs uppercase">LAB {numFormatted}</span>
        <Badge pixel variant={variantDif}>{badgeDif}</Badge>
      </div>
      <Badge pixel variant={variantEstado}>{badgeEstado}</Badge>
    </div>

    <span class="text-muted-foreground font-display text-[10px] uppercase">
      {data.modulo} · SEMANA {String(data.semanaAsociada).padStart(2, "0")}
    </span>

    <h3 class="h3 text-foreground text-balance">{data.titulo}</h3>
    <p class="text-muted-foreground text-xs font-semibold">{data.subtitulo}</p>
    <p class="text-muted-foreground line-clamp-2 text-xs leading-relaxed">{data.descripcion}</p>

    {/* Vista previa de fases pedagógicas */}
    {
      data.pasos && data.pasos.length > 0 && (
        <div class="border-border flex flex-wrap items-center gap-1.5 border-t-2 pt-3">
          {data.pasos.map((p) => {
            const { label } = faseBadgeMeta(p.fase);
            return (
              <span class="bg-accent text-accent-foreground border-border border px-2 py-0.5 text-[9px] font-bold uppercase">
                {label}
              </span>
            );
          })}
        </div>
      )
    }
  </div>

  <div class="border-border flex flex-wrap items-center justify-between gap-4 border-t-2 pt-4">
    <div class="flex items-center gap-2 text-xs">
      <PixelIcon name="code" class="text-info size-4" />
      {
        data.duracionEstimada && (
          <span class="text-muted-foreground text-xs font-bold">{data.duracionEstimada}</span>
        )
      }
    </div>

    {
      isAvailable ? (
        <a
          href={laboratorioPath(lab.id)}
          class="pixel-btn pixel-btn--blue px-4 py-2.5 text-xs uppercase"
        >
          Iniciar laboratorio ➔
        </a>
      ) : (
        <span class="bg-accent text-muted-foreground border-border border-2 px-3 py-2 text-xs font-bold uppercase">
          Contenido en preparación
        </span>
      )
    }
  </div>
</PixelPanel>
