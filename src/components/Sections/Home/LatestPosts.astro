---
// src/components/Sections/Home/LatestPosts.astro — Semanas Destacadas en la Portada.
import CardGrid from "@components/Sections/Global/CardGrid.astro";
import defaultHeroImage from "@images/demo/post-css-grid.jpg";
import { semanaPath } from "@js/paths";
import { estadoBadgeMeta, getSortedSemanas } from "@js/semanasData";

const semanas = (await getSortedSemanas()).slice(0, 3);
const items = semanas.map((semana) => {
  const { data } = semana;
  const { label, variant } = estadoBadgeMeta(data.estado);
  const numFormatted = String(data.numero).padStart(2, "0");
  return {
    href: semanaPath(semana.id),
    image: data.heroImage ?? defaultHeroImage,
    imageAlt: data.heroImageAlt ?? data.titulo,
    badgeLabel: label,
    badgeVariant: variant,
    title: `Semana ${numFormatted}: ${data.titulo}`,
    description: data.descripcion,
    cta: "Estudiar semana",
  };
});
---

<CardGrid headingId="latest-posts-heading" title="Semanas del Curso" items={items} />
