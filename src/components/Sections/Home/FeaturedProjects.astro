---
// src/components/Sections/Home/FeaturedProjects.astro — Laboratorios Computacionales en Portada.
import CardGrid from "@components/Sections/Global/CardGrid.astro";
import defaultHeroImage from "@images/demo/project-pixel-art.png";
import { dificultadBadgeMeta, getSortedLaboratorios } from "@js/laboratoriosData";
import { laboratorioPath } from "@js/paths";

const labs = (await getSortedLaboratorios()).slice(0, 3);
const items = labs.map((lab) => {
  const { data } = lab;
  const { label, variant } = dificultadBadgeMeta(data.dificultad);
  const numFormatted = String(data.numero).padStart(2, "0");
  return {
    href: laboratorioPath(lab.id),
    image: data.heroImage ?? defaultHeroImage,
    imageAlt: data.heroImageAlt ?? data.titulo,
    badgeLabel: label,
    badgeVariant: variant,
    title: `Lab ${numFormatted}: ${data.titulo}`,
    description: data.descripcion,
    cta: "Iniciar laboratorio",
  };
});
---

<CardGrid
  headingId="featured-projects-heading"
  title="Laboratorios Computacionales"
  items={items}
/>
