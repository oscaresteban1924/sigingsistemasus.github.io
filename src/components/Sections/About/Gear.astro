---
// src/components/Sections/About/Gear.astro — Entorno de Desarrollo y Software.
import SectionHeading from "@components/Sections/Global/SectionHeading.astro";
import { PixelPanel } from "@components/ui/pixel-panel";
import { Reveal } from "@components/ui/reveal";

const gear = [
  { label: "GIS Desktop", value: "QGIS 3.34 LTR" },
  { label: "Motor DB", value: "PostgreSQL 16 + PostGIS 3.4" },
  { label: "Lenguajes", value: "Python 3.11 / TypeScript" },
  { label: "Librerías", value: "GeoPandas / GDAL / Shapely" },
  { label: "Web GIS", value: "Leaflet / MapLibre GL JS" },
] as const;
---

<Reveal as="section" aria-labelledby="gear-heading" class="flex flex-col gap-6">
  <SectionHeading id="gear-heading" title="Entorno de Desarrollo y Software" />

  <PixelPanel as="dl" class="flex flex-col gap-3 p-5 sm:p-6">
    {
      gear.map((row) => (
        <div class="flex items-center justify-between gap-4 text-xs font-bold uppercase sm:text-sm">
          <dt class="text-info">{row.label}:</dt>
          <dd class="text-foreground">{row.value}</dd>
        </div>
      ))
    }
  </PixelPanel>
</Reveal>
