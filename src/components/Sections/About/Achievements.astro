---
// src/components/Sections/About/Achievements.astro — Unidades Temáticas del Curso.
import { type ContentCardProps } from "@components/Cards/ContentCard.astro";
import CardGrid from "@components/Sections/Global/CardGrid.astro";
import { sitePath } from "@js/paths";

import { demoThumbs } from "./demoThumbs";

const achievements: readonly ContentCardProps[] = [
  {
    ...demoThumbs.cliQuest,
    title: "Módulo 1: Fundamentos SIG & Modelos",
    description: "Abstracción de datos vectoriales (puntos, líneas, polígonos) y matrices raster.",
    href: sitePath("/semanas/"),
    badgeLabel: "Módulo 1",
    badgeVariant: "success",
    cta: "Ver",
  },
  {
    ...demoThumbs.retroChat,
    title: "Módulo 2: Coordenadas y CRS",
    description:
      "Geodesia, elipsoides, datums, proyecciones cartográficas y transformaciones EPSG.",
    href: sitePath("/semanas/"),
    badgeLabel: "Módulo 2",
    badgeVariant: "success",
    cta: "Ver",
  },
  {
    ...demoThumbs.cssGrid,
    title: "Módulo 3: Spatial SQL & PostGIS",
    description:
      "Bases de datos relacionales espaciales, predicados topológicos e índices GiST R-Tree.",
    href: sitePath("/semanas/"),
    badgeLabel: "Módulo 3",
    badgeVariant: "success",
    cta: "Ver",
  },
  {
    ...demoThumbs.retroDeploy,
    title: "Módulo 4: Geoprocesamiento Python",
    description:
      "Scripting automatizado con GeoPandas, Shapely y GDAL para análisis territorial masivo.",
    href: sitePath("/semanas/"),
    badgeLabel: "Módulo 4",
    badgeVariant: "success",
    cta: "Ver",
  },
  {
    ...demoThumbs.pixelArt,
    title: "Módulo 5: Servicios Web OGC",
    description: "Publicación de mapas e información geográfica con estándares WMS, WFS y WCS.",
    href: sitePath("/semanas/"),
    badgeLabel: "Módulo 5",
    badgeVariant: "success",
    cta: "Ver",
  },
  {
    ...demoThumbs.floppyDisk,
    title: "Módulo 6: Desarrollo Web GIS",
    description: "Creación de visores interactivos con Leaflet, MapLibre y consumo de APIs REST.",
    href: sitePath("/semanas/"),
    badgeLabel: "Módulo 6",
    badgeVariant: "success",
    cta: "Ver",
  },
];
---

<CardGrid
  headingId="achievements-heading"
  title="Unidades Temáticas del Curso"
  items={achievements}
/>
