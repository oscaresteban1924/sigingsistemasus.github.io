---
// src/components/Sections/Semanas/SemanaArticle.astro — Vista detallada y Guía de Estudio de la Semana.
import { PixelIcon } from "@components/svg/pixel-icons";
import { Badge } from "@components/ui/badge";
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "@components/ui/breadcrumb";
import { PixelPanel } from "@components/ui/pixel-panel";
import { type AdjacentSemanaLink, estadoBadgeMeta } from "@js/semanasData";
import type { CollectionEntry } from "astro:content";

interface Props {
  semana: CollectionEntry<"semanas">["data"];
  prev?: AdjacentSemanaLink;
  next?: AdjacentSemanaLink;
}

const { semana, prev, next } = Astro.props as Props;
const {
  numero,
  titulo,
  descripcion,
  objetivos,
  conceptosClave,
  estado,
  materiales,
  laboratorios,
  recursos,
  reto,
  preguntaDetonante,
  antesDeComenzar,
  preguntasParaPensar,
  rutaAprendizaje,
  importanciaIngSistemas,
  conceptosDetallados,
  duracionEstimada,
} = semana;

const numFormatted = String(numero).padStart(2, "0");
const { label: badgeLabel, variant: badgeVariant } = estadoBadgeMeta(estado);
---

<div class="flex flex-col gap-8">
  <!-- Breadcrumbs -->
  <Breadcrumb>
    <BreadcrumbItem><BreadcrumbLink href="/">Inicio</BreadcrumbLink></BreadcrumbItem>
    <BreadcrumbSeparator />
    <BreadcrumbItem><BreadcrumbLink href="/semanas/">Semanas</BreadcrumbLink></BreadcrumbItem>
    <BreadcrumbSeparator />
    <BreadcrumbItem><BreadcrumbPage>Semana {numFormatted}</BreadcrumbPage></BreadcrumbItem>
  </Breadcrumb>

  <!-- Header Hero Panel -->
  <PixelPanel as="header" elevated class="flex flex-col gap-6 p-6 sm:p-8">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="font-display text-info text-sm uppercase">SEMANA {numFormatted}</span>
        <Badge pixel variant={badgeVariant}>{badgeLabel}</Badge>
      </div>
      {
        duracionEstimada && (
          <span class="text-muted-foreground text-xs font-bold uppercase">
            Duración: {duracionEstimada}
          </span>
        )
      }
    </div>

    <h1 class="h1 text-foreground text-balance">{titulo}</h1>

    <p class="text-muted-foreground text-base leading-relaxed">{descripcion}</p>

    {
      conceptosClave && conceptosClave.length > 0 && (
        <div class="border-border flex flex-wrap items-center gap-2 border-t-2 pt-4">
          <span class="text-info font-display text-xs uppercase">Conceptos Clave:</span>
          {conceptosClave.map((concepto) => (
            <span class="bg-accent text-accent-foreground border-border border-2 px-2.5 py-1 text-xs font-bold uppercase">
              #{concepto}
            </span>
          ))}
        </div>
      )
    }
  </PixelPanel>

  <!-- Sección: ¿Qué vamos a resolver? -->
  {
    preguntaDetonante && (
      <PixelPanel class="border-info flex flex-col gap-4 p-6 sm:p-8">
        <div class="flex items-center gap-3">
          <PixelIcon name="code" class="text-info size-6" />
          <h2 class="font-display text-info text-sm uppercase">¿Qué vamos a resolver?</h2>
        </div>
        <blockquote class="text-foreground text-base leading-relaxed font-semibold italic sm:text-lg">
          "{preguntaDetonante}"
        </blockquote>
      </PixelPanel>
    )
  }

  <!-- Sección: Resultados de Aprendizaje -->
  {
    objetivos && objetivos.length > 0 && (
      <PixelPanel class="flex flex-col gap-6 p-6 sm:p-8">
        <div class="flex items-center gap-3">
          <PixelIcon name="component" class="text-success size-6" />
          <h2 class="h3 text-secondary-700 dark:text-secondary">Resultados de Aprendizaje</h2>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {objetivos.map((obj, idx) => (
            <div class="bg-accent border-border flex gap-3 border-2 p-4">
              <span class="font-display text-info text-xs font-bold">0{idx + 1}.</span>
              <p class="text-muted-foreground text-sm leading-relaxed">{obj}</p>
            </div>
          ))}
        </div>
      </PixelPanel>
    )
  }

  <!-- Sección: Ruta de Aprendizaje de la Semana -->
  {
    rutaAprendizaje && rutaAprendizaje.length > 0 && (
      <PixelPanel class="flex flex-col gap-6 p-6 sm:p-8">
        <div class="flex items-center gap-3">
          <PixelIcon name="component" class="text-info size-6" />
          <h2 class="h3 text-secondary-700 dark:text-secondary">Ruta de Aprendizaje</h2>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {rutaAprendizaje.map((bloque) => (
            <div class="bg-accent border-border flex flex-col gap-2 border-2 p-4">
              <span class="font-display text-info text-xs uppercase">Bloque {bloque.paso}</span>
              <h3 class="font-display text-foreground text-xs uppercase">{bloque.titulo}</h3>
              <p class="text-muted-foreground text-xs leading-relaxed">{bloque.descripcion}</p>
            </div>
          ))}
        </div>
      </PixelPanel>
    )
  }

  <!-- Sección: Antes de Comenzar & Material de Clase (Grid 2 columnas) -->
  <div class="grid gap-6 lg:grid-cols-2">
    <!-- Antes de Comenzar -->
    {
      antesDeComenzar && antesDeComenzar.length > 0 && (
        <PixelPanel class="flex flex-col gap-4 p-6">
          <div class="flex items-center gap-3">
            <PixelIcon name="type" class="text-warning size-5" />
            <h2 class="h3 text-foreground">Antes de comenzar</h2>
          </div>
          <p class="text-muted-foreground text-xs">
            Reflexiona sobre estas preguntas de activación conceptual antes de ingresar a la clase:
          </p>
          <ul class="flex flex-col gap-3">
            {antesDeComenzar.map((preg) => (
              <li class="bg-accent border-border flex gap-3 border-2 p-3">
                <span class="text-warning font-bold">?</span>
                <p class="text-foreground text-xs leading-relaxed">{preg}</p>
              </li>
            ))}
          </ul>
        </PixelPanel>
      )
    }

    <!-- Material de Clase -->
    {
      materiales && materiales.length > 0 && (
        <PixelPanel class="flex flex-col gap-4 p-6">
          <div class="flex items-center gap-3">
            <PixelIcon name="package" class="text-info size-5" />
            <h2 class="h3 text-foreground">Material de Clase</h2>
          </div>
          <div class="flex flex-col gap-4">
            {materiales.map((mat) => (
              <div class="bg-accent border-border flex flex-col justify-between gap-3 border-2 p-4">
                <div class="flex flex-col gap-2">
                  <div class="flex items-center justify-between gap-2">
                    <Badge pixel variant="primary">
                      {mat.tipo}
                    </Badge>
                    {mat.tamano && (
                      <span class="text-muted-foreground text-[10px] font-bold">{mat.tamano}</span>
                    )}
                  </div>
                  <h3 class="font-display text-foreground text-xs uppercase">{mat.nombre}</h3>
                  {mat.descripcion && (
                    <p class="text-muted-foreground text-xs">{mat.descripcion}</p>
                  )}
                </div>
                <div class="flex flex-wrap gap-2 pt-2">
                  <a
                    href={mat.url}
                    download
                    target="_blank"
                    rel="noopener noreferrer"
                    class="pixel-btn pixel-btn--blue flex-1 px-3 py-2 text-center text-xs uppercase"
                  >
                    Descargar presentación de clase ⬇
                  </a>
                  <a
                    href={mat.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="pixel-btn flex-1 px-3 py-2 text-center text-xs uppercase"
                  >
                    Abrir en navegador ↗
                  </a>
                </div>
              </div>
            ))}
          </div>
        </PixelPanel>
      )
    }
  </div>

  <!-- Sección: Preguntas para Pensar -->
  {
    preguntasParaPensar && preguntasParaPensar.length > 0 && (
      <PixelPanel class="flex flex-col gap-6 p-6 sm:p-8">
        <div class="flex items-center gap-3">
          <PixelIcon name="code" class="text-info size-6" />
          <h2 class="h3 text-secondary-700 dark:text-secondary">Preguntas para Pensar</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          {preguntasParaPensar.map((item) => (
            <div class="bg-accent border-border flex flex-col gap-3 border-2 p-4">
              <h3 class="font-display text-foreground text-xs uppercase">{item.pregunta}</h3>
              <p class="text-muted-foreground text-xs leading-relaxed font-normal">
                {item.respuestaContextual}
              </p>
            </div>
          ))}
        </div>
      </PixelPanel>
    )
  }

  <!-- Sección: Conceptos Clave con Enfoque en Ingeniería de Sistemas -->
  {
    conceptosDetallados && conceptosDetallados.length > 0 && (
      <PixelPanel class="flex flex-col gap-6 p-6 sm:p-8">
        <div class="flex items-center gap-3">
          <PixelIcon name="code" class="text-secondary size-6" />
          <h2 class="h3 text-secondary-700 dark:text-secondary">Conceptos Clave</h2>
        </div>
        <div class="grid gap-6 md:grid-cols-2">
          {conceptosDetallados.map((item) => (
            <div class="bg-accent border-border flex flex-col gap-3 border-2 p-5">
              <div class="border-border flex items-center justify-between border-b-2 pb-2">
                <h3 class="font-display text-info text-xs uppercase">{item.concepto}</h3>
                <Badge pixel variant="secondary">
                  Sistemas
                </Badge>
              </div>
              <p class="text-foreground text-xs leading-relaxed">
                <strong>Definición:</strong> {item.definicion}
              </p>
              <p class="text-muted-foreground text-xs leading-relaxed">
                <strong>Contexto:</strong> {item.contexto}
              </p>
              <div class="border-border bg-background border-2 p-3">
                <span class="font-display text-success text-[10px] uppercase">
                  En Ingeniería de Sistemas:
                </span>
                <p class="text-muted-foreground mt-1 text-xs leading-relaxed">
                  {item.relacionIngSistemas}
                </p>
              </div>
            </div>
          ))}
        </div>
      </PixelPanel>
    )
  }

  <!-- Sección: ¿Por qué esto importa en Ingeniería de Sistemas? -->
  {
    importanciaIngSistemas && importanciaIngSistemas.length > 0 && (
      <PixelPanel class="border-success flex flex-col gap-6 p-6 sm:p-8">
        <div class="flex items-center gap-3">
          <PixelIcon name="code" class="text-success size-6" />
          <h2 class="h3 text-success">¿Por qué esto importa en Ingeniería de Sistemas?</h2>
        </div>
        <p class="text-muted-foreground text-xs sm:text-sm">
          Un SIG no es un programa de dibujo cartográfico. Es un ecosistema informático distribuido
          donde el mapa es únicamente la interfaz visual de salida (View), respaldado por un modelo
          analítico computacional de alta precisión.
        </p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {importanciaIngSistemas.map((item) => (
            <div class="bg-accent border-border flex flex-col gap-2 border-2 p-4">
              <h3 class="font-display text-foreground text-xs uppercase">{item.concepto}</h3>
              <p class="text-muted-foreground text-xs leading-relaxed">{item.aplicacion}</p>
            </div>
          ))}
        </div>
      </PixelPanel>
    )
  }

  <!-- Sección: Reto de la Semana -->
  {
    reto && (
      <PixelPanel class="border-warning flex flex-col gap-4 p-6 sm:p-8">
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <PixelIcon name="server" class="text-warning size-6" />
            <h2 class="h3 text-warning">Reto de la Semana</h2>
          </div>
          <Badge pixel variant="warning">
            System Design
          </Badge>
        </div>
        <h3 class="font-display text-foreground text-sm uppercase">{reto.titulo}</h3>
        <p class="text-muted-foreground text-xs leading-relaxed sm:text-sm">{reto.descripcion}</p>
      </PixelPanel>
    )
  }

  <!-- Desarrollo Teórico y Contenido MDX Libre -->
  <PixelPanel class="flex flex-col gap-4 p-6 sm:p-8">
    <h2 class="h3 text-secondary-700 dark:text-secondary">Desarrollo Teórico y Guía Completa</h2>
    <div class="blog-prose">
      <slot />
    </div>
  </PixelPanel>

  <!-- Secciones adicionales (Laboratorios y Recursos de consulta) -->
  <div class="grid gap-6 md:grid-cols-2">
    {
      laboratorios && laboratorios.length > 0 && (
        <PixelPanel class="flex flex-col gap-4 p-6">
          <h2 class="font-display text-info text-xs uppercase">Laboratorios Vinculados</h2>
          <ul class="flex flex-col gap-3">
            {laboratorios.map((lab) => (
              <li class="bg-accent border-border flex flex-col gap-2 border-2 p-3">
                <span class="font-display text-foreground text-xs uppercase">{lab.titulo}</span>
                {lab.descripcion && <p class="text-muted-foreground text-xs">{lab.descripcion}</p>}
                {lab.slug && (
                  <a
                    href={`/projects/${lab.slug}/`}
                    class="text-info hover:text-success text-xs font-bold uppercase transition-colors"
                  >
                    Ver Laboratorio ➔
                  </a>
                )}
              </li>
            ))}
          </ul>
        </PixelPanel>
      )
    }

    {
      recursos && recursos.length > 0 && (
        <PixelPanel class="flex flex-col gap-4 p-6">
          <h2 class="font-display text-info text-xs uppercase">Recursos de Consulta</h2>
          <ul class="flex flex-col gap-2 text-xs">
            {recursos.map((rec) => (
              <li>
                <a
                  href={rec.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-info hover:text-success font-bold underline transition-colors"
                >
                  {rec.nombre} ↗
                </a>
              </li>
            ))}
          </ul>
        </PixelPanel>
      )
    }
  </div>

  <!-- Navegación Continuar a Semana 2 / Anterior al Final -->
  <PixelPanel as="footer" class="flex flex-wrap items-center justify-between gap-4 p-6">
    {
      prev ? (
        <a
          href={prev.href}
          rel="prev"
          class="primary-focus text-info hover:text-success inline-flex items-center gap-2 text-xs font-bold uppercase transition-colors"
        >
          <PixelIcon name="arrow-left" class="size-4" />
          Semana {String(prev.numero).padStart(2, "0")}: {prev.title}
        </a>
      ) : (
        <span />
      )
    }

    {
      next && (
        <a
          href={next.href}
          rel="next"
          class="pixel-btn pixel-btn--blue ml-auto px-5 py-3 text-xs uppercase sm:text-sm"
        >
          Continuar a Semana {String(next.numero).padStart(2, "0")} ➔
        </a>
      )
    }
  </PixelPanel>
</div>
