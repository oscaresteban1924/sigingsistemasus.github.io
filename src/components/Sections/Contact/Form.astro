---
// src/components/Sections/Contact/Form.astro — Formulario de consultas en Spanish.
import { Badge } from "@components/ui/badge";
import { Input } from "@components/ui/input";
import { Label } from "@components/ui/label";
import { PixelPanel } from "@components/ui/pixel-panel";
import { Textarea } from "@components/ui/textarea";

const FIELDS = [
  {
    name: "name",
    label: "Tu Nombre Completo",
    placeholder: "Ej. MARÍA RODRÍGUEZ",
    as: "input",
    type: "text",
    autocomplete: "name",
    maxlength: 100,
  },
  {
    name: "email",
    label: "Correo Electrónico Institucional",
    placeholder: "Ej. ESTUDIANTE@INSTITUCION.EDU.CO",
    as: "input",
    type: "email",
    autocomplete: "email",
    maxlength: 254,
  },
  {
    name: "subject",
    label: "Asunto de la Consulta",
    placeholder: "Ej. CONSULTA POSTGIS LAB 2",
    as: "input",
    type: "text",
    autocomplete: "off",
    maxlength: 150,
  },
  {
    name: "message",
    label: "Mensaje o Inquietud",
    placeholder: "ESCRIBE TU CONSULTA AQUÍ...",
    as: "textarea",
    autocomplete: "off",
    maxlength: 5000,
  },
] as const;

const fieldClass = [
  "bg-accent border-border rounded-none border-4 px-4 text-sm placeholder:text-muted-foreground",
  "aria-[invalid=true]:ring-3 aria-[invalid=true]:ring-error/60",
].join(" ");
---

<div>
  <!-- Success panel (shown dynamically on submit) -->
  <PixelPanel
    elevated
    role="status"
    tabindex="-1"
    data-contact-success
    class="primary-focus hidden flex-col items-start gap-3 p-8"
  >
    <Badge pixel variant="success"> Consulta Enviada </Badge>
    <h2 class="h3 text-foreground">Mensaje recibido.</h2>
    <p class="text-muted-foreground text-sm">
      Gracias — tu consulta ha sido registrada. La coordinación docente responderá a tu correo.
    </p>
  </PixelPanel>

  <!-- Main form panel -->
  <PixelPanel elevated data-contact-form-panel class="flex flex-col gap-6 p-6 sm:p-8">
    <h2 class="text-secondary-700 dark:text-secondary font-display text-base uppercase sm:text-lg">
      Enviar Consulta Docente
    </h2>

    <form id="contact-form" class="flex flex-col gap-4" novalidate>
      {
        FIELDS.map((field) => {
          const attrs = {
            id: field.name,
            name: field.name,
            placeholder: field.placeholder,
            autocomplete: field.autocomplete,
            required: true,
            maxlength: field.maxlength,
          };
          return (
            <div class="flex flex-col gap-2">
              <Label for={field.name} class="text-info font-display text-xs uppercase">
                {field.label}
              </Label>
              {field.as === "textarea" ? (
                <Textarea {...attrs} minlength={10} class={`${fieldClass} min-h-[120px] py-3`} />
              ) : (
                <Input {...attrs} type={field.type} class={`${fieldClass} h-14`} />
              )}
              <p id={`${field.name}-error`} role="alert" class="text-error hidden text-xs" />
            </div>
          );
        })
      }

      {/* Honeypot anti-spam field */}
      <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
        <label for="_gotcha">Leave this field empty</label>
        <input id="_gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      </div>

      <button
        type="submit"
        class="pixel-btn pixel-btn--green mt-2 self-start px-6 py-3 text-sm uppercase sm:text-base"
      >
        Enviar Consulta
      </button>
    </form>
  </PixelPanel>
</div>

<script>
  function initContactForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const successPanel = document.querySelector("[data-contact-success]") as HTMLElement | null;
    const formPanel = document.querySelector("[data-contact-form-panel]") as HTMLElement | null;

    if (!form || !successPanel || !formPanel) return;

    form.addEventListener("submit", (e) => {
      e.preventDefault();

      let valid = true;
      const inputs = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        "input[required], textarea[required]",
      );

      inputs.forEach((input) => {
        const errorEl = document.getElementById(`${input.name}-error`);
        if (!input.value.trim()) {
          valid = false;
          input.setAttribute("aria-invalid", "true");
          if (errorEl) {
            errorEl.textContent = "Este campo es obligatorio.";
            errorEl.classList.remove("hidden");
          }
        } else if (
          input.type === "email" &&
          !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value.trim())
        ) {
          valid = false;
          input.setAttribute("aria-invalid", "true");
          if (errorEl) {
            errorEl.textContent = "Por favor ingresa un correo electrónico válido.";
            errorEl.classList.remove("hidden");
          }
        } else if (input.tagName.toLowerCase() === "textarea" && input.value.trim().length < 10) {
          valid = false;
          input.setAttribute("aria-invalid", "true");
          if (errorEl) {
            errorEl.textContent = "Por favor escribe al menos 10 caracteres.";
            errorEl.classList.remove("hidden");
          }
        } else {
          input.removeAttribute("aria-invalid");
          if (errorEl) {
            errorEl.textContent = "";
            errorEl.classList.add("hidden");
          }
        }
      });

      if (valid) {
        formPanel.classList.add("hidden");
        formPanel.classList.remove("flex");
        successPanel.classList.remove("hidden");
        successPanel.classList.add("flex");
        successPanel.focus();
      }
    });
  }

  initContactForm();
  document.addEventListener("astro:after-swap", initContactForm);
</script>
