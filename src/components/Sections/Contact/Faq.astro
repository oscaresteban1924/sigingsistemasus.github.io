---
// src/components/Sections/Contact/Faq.astro — Preguntas Frecuentes del Curso.
import SectionHeading from "@components/Sections/Global/SectionHeading.astro";
import { Accordion, AccordionContent, AccordionItem } from "@components/ui/accordion";
import { PixelPanel } from "@components/ui/pixel-panel";
import { Reveal } from "@components/ui/reveal";

const faqs = [
  {
    q: "¿Qué software libre necesito instalar para el laboratorio?",
    a: "Requerimos QGIS 3.34 LTR, PostgreSQL 16 con la extensión PostGIS 3.4 y Python 3.11 con GeoPandas, Shapely y GDAL.",
  },
  {
    q: "¿Dónde encuentro las guías y los datasets de los laboratorios?",
    a: "Todos los datasets y guías están organizados por semana en la sección Laboratorios de esta plataforma y en el repositorio oficial de GitHub.",
  },
  {
    q: "¿Cómo se evalúan los proyectos computacionales?",
    a: "Cada laboratorio incluye entregables de código SQL/Python, archivos GeoJSON y una breve sustentación del modelo computacional implementado.",
  },
] as const;
---

<Reveal as="section" aria-labelledby="faq-heading" class="flex flex-col gap-6">
  <SectionHeading id="faq-heading" title="Preguntas Frecuentes del Curso" />

  <PixelPanel elevated class="px-6 py-2 sm:px-8">
    <Accordion class="border-t-0">
      {
        faqs.map((faq, i) => (
          <AccordionItem
            open={i === 0}
            class="border-base-300 border-t-0 border-b-2 border-dashed [&[open]_[data-faq-v]]:opacity-0"
          >
            <summary class="text-secondary-700 dark:text-secondary font-display focus-visible:ring-outline flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-xs leading-relaxed outline-none focus-visible:ring-3 [&::-webkit-details-marker]:hidden">
              <span>{faq.q}</span>
              <span class="relative ml-2 size-4 shrink-0" aria-hidden="true">
                <span class="bg-muted-foreground absolute top-1/2 left-0 h-1 w-full -translate-y-1/2" />
                <span
                  data-faq-v
                  class="bg-muted-foreground absolute top-0 left-1/2 h-full w-1 -translate-x-1/2 transition-opacity"
                />
              </span>
            </summary>
            <AccordionContent class="text-muted-foreground pt-0 pb-4 text-sm">
              {faq.a}
            </AccordionContent>
          </AccordionItem>
        ))
      }
    </Accordion>
  </PixelPanel>
</Reveal>
